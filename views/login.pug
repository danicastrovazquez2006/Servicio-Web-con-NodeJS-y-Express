extends layout
block content
  .container
    h2 Iniciar Sesión
    if error
      p(style="color:red;")= error
    form(action="/login" method="POST")
      div
        label Usuario:
        input(type="text" name="username" required)
      div
        label Contraseña:
        input(type="password" name="password" required)
      button(type="submit") Entrar