extends ../layout

block content
  .container
    .toolbar
      div
        h2 Gestión de Usuarios
        p.subtitle Cuentas registradas en el sistema y asignación de grupos
      a.btn(href="/users/create") + Nuevo Usuario

    table
      thead
        tr
          th Foto
          th Usuario
          th Rol
          th Grupo
          th Acciones
      tbody
        each u in users
          tr
            td
              if u.photo
                img.avatar-sm(src=u.photo alt=`Foto de ${u.username}`)
              else
                span.subtitle Sin foto
            td
              strong= u.username
            td
              span.badge= u.role
            td
              span.badge.badge-group= u.group_name || 'Sin grupo'
            td
              a.btn.btn-danger(href=`/users/delete/${u.id}`) Eliminar

    .actions-grid
      a.btn.btn-secondary(href="/dashboard") Volver al Panel