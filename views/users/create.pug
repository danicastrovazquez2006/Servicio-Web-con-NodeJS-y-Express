extends ../layout

block content
  .container
    .toolbar
      div
        h2 Alta de Nuevo Usuario
        p.subtitle Configura las credenciales, el grupo y la foto de perfil
      a.btn.btn-secondary(href="/users") Volver a Usuarios

    form(action="/users/create" method="POST" enctype="multipart/form-data")
      .form-group
        label(for="username") Nombre de usuario
        input#username(type="text" name="username" required)
      .form-group
        label(for="password") Contraseña
        input#password(type="password" name="password" required)
      .form-group
        label(for="role") Rol de acceso
        select#role(name="role")
          option(value="user") Usuario estándar
          option(value="admin") Administrador
      .form-group
        label(for="group_id") Grupo asignado
        select#group_id(name="group_id")
          option(value="") Sin grupo asignado
          each g in groups
            option(value=g.id)= g.name
      .form-group
        label(for="photo") Foto de perfil
        input#photo(type="file" name="photo" accept="image/*")
      .actions-grid
        button.btn(type="submit") Guardar Usuario
        a.btn.btn-secondary(href="/users") Cancelar