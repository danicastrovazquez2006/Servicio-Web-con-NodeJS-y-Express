extends ../layout

block content
  .container
    .toolbar
      div
        h2 Gestión de Grupos
        p.subtitle Crea y organiza los grupos de comunicación interna
      a.btn.btn-secondary(href="/dashboard") Volver al Panel

    form(action="/groups/create" method="POST")
      .form-group
        label(for="name") Nombre del nuevo grupo
        input#name(type="text" name="name" placeholder="Ej. Desarrollo Web" required)
      button.btn(type="submit") + Crear Grupo

    h3 Grupos Activos (#{groups.length})
    if groups.length === 0
      p.subtitle Todavía no hay grupos creados.
    else
      ul.item-list
        each g in groups
          li
            strong= g.name
            a.btn.btn-danger(href=`/groups/delete/${g.id}`) Eliminar